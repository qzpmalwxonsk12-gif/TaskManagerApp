<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/session_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/notif_text_primary"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/session_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/notif_text_secondary"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/session_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/session_btn1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:text="Start" />

        <Button
            android:id="@+id/session_btn2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:visibility="gone"
            android:text="+5" />

        <Button
            android:id="@+id/session_btn3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:visibility="gone"
            android:text="+10" />

        <Button
            android:id="@+id/session_btn4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:visibility="gone"
            android:text="+15" />

        <Button
            android:id="@+id/session_btn5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:visibility="gone"
            android:text="Done" />
    </LinearLayout>

</LinearLayout>
