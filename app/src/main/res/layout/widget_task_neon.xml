<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_round_mask" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_paper_art" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="8dp">
            <TextView android:id="@+id/widget_eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="THE DAILY EDIT" android:textSize="9sp" android:letterSpacing="0.12"
                android:textColor="#806345" android:singleLine="true" android:ellipsize="end" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp">
                <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="Your day" android:fontFamily="monospace"
                    android:textSize="19sp" android:textColor="#493C32" android:singleLine="true" android:ellipsize="end" />
                <TextView android:id="@+id/widget_progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:textSize="12sp" android:textColor="#806345" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/widget_container" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/widget_empty" android:text="A little space for your day." android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="8dp" android:textColor="#766553" android:textSize="13sp" android:visibility="gone" />
        </FrameLayout>
        <TextView android:id="@+id/widget_overflow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="#766553" android:singleLine="true" android:ellipsize="end"
            android:paddingTop="2dp" android:paddingBottom="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/widget_switch" android:text="Next page" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:layout_marginEnd="3dp" android:gravity="center"
                android:background="@drawable/widget_paper_button" android:textColor="#493C32" android:textSize="12sp"
                android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/widget_add" android:text="+ Task" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:layout_marginStart="3dp" android:gravity="center"
                android:background="@drawable/widget_paper_button" android:textColor="#493C32" android:textSize="12sp"
                android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
