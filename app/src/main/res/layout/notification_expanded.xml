<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Header: period name + progress fraction -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_period"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/notif_text_primary"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/notif_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/notif_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Action buttons live directly under the header so they are never clipped by a long list -->
    <LinearLayout
        android:id="@+id/notif_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/notif_add_task"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:textSize="13sp"
            android:text="+ Task" />

        <Button
            android:id="@+id/notif_add_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:textSize="13sp"
            android:text="+ Note" />
    </LinearLayout>

    <!-- Summary block (shown briefly during a period transition) -->
    <TextView
        android:id="@+id/notif_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:textColor="@color/notif_text_primary"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp" />

    <!-- Task rows are added here dynamically by the service (reliable across OS versions) -->
    <LinearLayout
        android:id="@+id/notif_task_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/notif_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        android:gravity="center"
        android:textColor="@color/notif_text_secondary"
        android:textSize="14sp" />

</LinearLayout>
